#!/bin/sh
# Public hostname. Use chat.yauvanchakra.com so the website can stay on the apex.
REG_TOKEN=
DOMAIN=chat.yauvanchakra.com
ROOT_URL=https://chat.yauvanchakra.com
RELEASE=8.0.1
LETSENCRYPT_ENABLED=true
LETSENCRYPT_EMAIL=admin@yauvanchakra.com
TRAEFIK_PROTOCOL=https

# Prometheus
PROMETHEUS_RETENTION_SIZE=15GB
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_PORT=9000

# Grafana stays on localhost. Do not publish 5050 to the internet.
GRAFANA_DOMAIN=
GRAFANA_PATH=/grafana
GRAFANA_ADMIN_PASSWORD=change-this-password
GRAFANA_HOST_PORT=5050
GRAFANA_BIND_IP=127.0.0.1

# Traefik ports
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_HTTPS_PORT=443

# MongoDB and NATS stay on localhost
MONGODB_BIND_IP=127.0.0.1
MONGODB_PORT_NUMBER=27017
NATS_PORT_NUMBER=4222
NATS_BIND_IP=127.0.0.1

# Branding (pair with compose.yauvanchakra-branding.yml)
YAUVANCHAKRA_SITE_NAME=Yauvanchakra
YAUVANCHAKRA_ORG_NAME=Yauvanchakra
YAUVANCHAKRA_HOME_TITLE=Home
